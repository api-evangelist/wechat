                    },
                    {
                      "key": "js_code",
                      "value": "<string>"
                    },
                    {
                      "key": "grant_type",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
