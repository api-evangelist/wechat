  "item": [
    {
      "id": "a733a3bf-501f-4511-91d3-3826d237deda",
      "name": "Access Token",
      "description": {
        "content": "Application-level access token management.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d867535f-b360-4da7-8bd4-0eb9f8e5b626",
          "name": "auth.getAccessToken",
          "request": {
            "name": "auth.getAccessToken",
            "description": {
              "content": "Obtain the global application `access_token` for a Mini Program.\nReturned tokens are valid for 7200 seconds and must be cached and\nre-used across the application; concurrent calls will overwrite each\nother.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cgi-bin",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) Must be set to `client_credential`."
                },
                {
                  "disabled": false,
                  "key": "appid",
                  "value": "<string>",
                  "description": "(Required) Mini Program AppID from the WeChat Official Accounts Platform."
                },
                {
                  "disabled": false,
                  "key": "secret",
                  "value": "<string>",
                  "description": "(Required) Mini Program AppSecret."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "5c960f92-17ca-4e4a-807c-861ef6f11126",
              "name": "Access token response.",
              "originalRequest": {
                "url": {
                  "path": [
                    "cgi-bin",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "grant_type",
                      "value": "<string>"
                    },
                    {
                      "key": "appid",
                      "value": "<string>"
                    },
                    {
                      "key": "secret",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"ACCESS_TOKEN\",\n  \"expires_in\": 7200\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
